# === Vercel / ローカル開発 ===
# サーバー側 API Route で使用（ブラウザには公開されない・安全）
ANTHROPIC_API_KEY=your_api_key_here

# === GitHub Pages のみ ===
# ブラウザから直接 Anthropic API を呼び出す場合（静的エクスポート時）
# ⚠️ ビルド成果物の HTML に含まれるため、個人利用・デモ用途向け
# NEXT_PUBLIC_ANTHROPIC_API_KEY=your_api_key_here
# NEXT_PUBLIC_IS_STATIC=true
# STATIC_EXPORT=true
